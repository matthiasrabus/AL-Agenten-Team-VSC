{
  "hooks": {
    "PreToolUse": [
      {
        "type": "command",
        "command": "node ${PLUGIN_ROOT}/scripts/al-hook.cjs guard global",
        "timeout": 10
      }
    ],
    "SubagentStop": [
      {
        "type": "command",
        "command": "node ${PLUGIN_ROOT}/scripts/al-hook.cjs stop auto",
        "timeout": 20
      }
    ]
  }
}
